[Desktop Entry]
Name=Kity
GenericName=Asistente de IA y Voz
GenericName[es]=Asistente de IA y Voz
Comment=Asistente conversacional de inteligencia artificial estilo Siri para KDE Plasma
Comment[es]=Asistente conversacional de inteligencia artificial estilo Siri para KDE Plasma
Exec=kity %u
Icon=org.cesar.kity
Terminal=false
Type=Application
Categories=Utility;AudioVideo;System;
StartupWMClass=org.cesar.kity
StartupNotify=true
MimeType=x-scheme-handler/kity;
Actions=QuickPill;OpenApp;NewChat;Listen;OCR;AskScreen;WritingTools;

[Desktop Action QuickPill]
Name=Cápsula Rápida (Search or Ask)
Name[es]=Cápsula Rápida (Search or Ask)
Exec=kity --pill
Icon=system-search-symbolic

[Desktop Action OpenApp]
Name=Abrir aplicación completa de Kity
Name[es]=Abrir aplicación completa de Kity
Exec=kity --app
Icon=org.cesar.kity

[Desktop Action NewChat]
Name=Nueva conversación
Name[es]=Nueva conversación
Exec=kity --new-chat
Icon=document-new

[Desktop Action Listen]
Name=Hablar por voz
Name[es]=Hablar por voz
Exec=kity --listen
Icon=audio-input-microphone

[Desktop Action OCR]
Name=Captura de pantalla inteligente (Live Text)
Name[es]=Captura de pantalla inteligente (Live Text)
Exec=kity --ocr
Icon=select-rectangular

[Desktop Action AskScreen]
Name=Preguntar sobre esta pantalla
Name[es]=Preguntar sobre esta pantalla
Exec=kity --ask-screen
Icon=system-search-symbolic

[Desktop Action WritingTools]
Name=Herramientas de Escritura (Apple Intelligence)
Name[es]=Herramientas de Escritura (Apple Intelligence)
Exec=kity --writing-tools
Icon=document-edit-symbolic
