[Desktop Entry]
Type=Service
Name=Kity Inteligencia Artificial
Name[es]=Kity Inteligencia Artificial
MimeType=all/all;
X-KDE-Protocols=file
Actions=SummarizeDoc;AskDoc;OcrImage;ExplainImage;TranscribeAudio;AddToRAG;OpenRAGFolder;
X-KDE-Submenu=Kity Inteligencia Artificial
X-KDE-Submenu[es]=Kity Inteligencia Artificial
Icon=org.cesar.kity

[Desktop Action SummarizeDoc]
Name=Resumir documento con Apple Intelligence
Name[es]=Resumir documento con Apple Intelligence
Icon=document-edit-symbolic
Exec=kity --summarize %f

[Desktop Action AskDoc]
Name=Preguntar a Kity sobre este archivo…
Name[es]=Preguntar a Kity sobre este archivo…
Icon=system-search-symbolic
Exec=kity --file %f

[Desktop Action OcrImage]
Name=Extraer texto de imagen (Live Text OCR)
Name[es]=Extraer texto de imagen (Live Text OCR)
Icon=select-rectangular
Exec=kity --ocr-file %f

[Desktop Action ExplainImage]
Name=Analizar imagen con Kity Visión
Name[es]=Analizar imagen con Kity Visión
Icon=org.cesar.kity
Exec=kity --vision-file %f

[Desktop Action TranscribeAudio]
Name=Transcribir audio con Whisper local
Name[es]=Transcribir audio con Whisper local
Icon=audio-input-microphone
Exec=kity --transcribe-file %f

[Desktop Action AddToRAG]
Name=Añadir a la base de conocimiento local (RAG)
Name[es]=Añadir a la base de conocimiento local (RAG)
Icon=bookmark-new
Exec=kity --add-knowledge %f

[Desktop Action OpenRAGFolder]
Name=Abrir carpeta de Conocimiento RAG…
Name[es]=Abrir carpeta de Conocimiento RAG…
Icon=folder-open-symbolic
Exec=kity --open-knowledge
